# SmartScribe Environment Configuration Example

# Speech-to-Text & Clinical Entity LLM (Groq - Free Tier)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b

# MongoDB Database Connection String (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartscribe?retryWrites=true&w=majority

# JWT Session Secret
JWT_SECRET=smartscribe_super_secret_clinical_jwt_key_2026

# Default Attending Doctor Profile
DOCTOR_EMAIL=doctor@smartscribe.com
DOCTOR_PASSWORD=doctor123
DOCTOR_NAME=Dr. Sarah Jenkins, MD
